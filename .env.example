# Template for local Langfuse Observability testing.
# Copy to .env and fill in real values — .env is gitignored and never committed.
# In real claude.ai Cloud Environments these are set as "Environment Variables"
# in the environment config instead; this file is only a fallback/manual path.

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
